{
  "info": {
    "name": "Blueprint API - SANITY",
    "description": "Focused: the core product flows work end to end. Creates and deletes its own test data. Use on test/staging, not production.",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "auth": {
    "type": "bearer",
    "bearer": [
      {
        "key": "token",
        "value": "{{userToken}}",
        "type": "string"
      }
    ]
  },
  "variable": [
    {
      "key": "baseUrl",
      "value": "http://localhost:8080"
    },
    {
      "key": "userToken",
      "value": ""
    },
    {
      "key": "adminToken",
      "value": ""
    },
    {
      "key": "productId",
      "value": "1"
    },
    {
      "key": "sku",
      "value": ""
    },
    {
      "key": "idemKey",
      "value": ""
    },
    {
      "key": "idemSku",
      "value": ""
    }
  ],
  "item": [
    {
      "name": "Setup",
      "item": [
        {
          "name": "Login as user",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/api/auth/login",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "api",
                "auth",
                "login"
              ]
            },
            "body": {
              "mode": "raw",
              "raw": "{\n  \"username\": \"user\",\n  \"password\": \"user123\"\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            },
            "auth": {
              "type": "noauth"
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"status is 200\", function () { pm.response.to.have.status(200); });",
                  "pm.test(\"token returned\", function () { const j = pm.response.json(); pm.expect(j.data.tokenType === \"Bearer\" && !!j.data.accessToken, \"token returned\").to.be.true; });",
                  "pm.collectionVariables.set(\"userToken\", pm.response.json().data.accessToken);"
                ]
              }
            }
          ]
        },
        {
          "name": "Login as admin",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/api/auth/login",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "api",
                "auth",
                "login"
              ]
            },
            "body": {
              "mode": "raw",
              "raw": "{\n  \"username\": \"admin\",\n  \"password\": \"admin123\"\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            },
            "auth": {
              "type": "noauth"
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"status is 200\", function () { pm.response.to.have.status(200); });",
                  "pm.collectionVariables.set(\"adminToken\", pm.response.json().data.accessToken);"
                ]
              }
            }
          ]
        }
      ]
    },
    {
      "name": "Product lifecycle",
      "item": [
        {
          "name": "Create",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/api/products",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "api",
                "products"
              ]
            },
            "body": {
              "mode": "raw",
              "raw": "{\n  \"name\": \"API test product\",\n  \"description\": \"created by api-tests\",\n  \"price\": 19.99,\n  \"category\": \"BOOKS\",\n  \"sku\": \"{{sku}}\",\n  \"stock\": 5\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            }
          },
          "event": [
            {
              "listen": "prerequest",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.collectionVariables.set(\"sku\", \"API-\" + Math.random().toString(36).substring(2, 10).toUpperCase());"
                ]
              }
            },
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"status is 201\", function () { pm.response.to.have.status(201); });",
                  "pm.test(\"header Location present\", function () { pm.expect(pm.response.headers.has(\"Location\")).to.be.true; });",
                  "pm.test(\"body\", function () { const j = pm.response.json(); pm.expect(j.data.name === \"API test product\", \"body\").to.be.true; });",
                  "pm.collectionVariables.set(\"productId\", pm.response.json().data.id);"
                ]
              }
            }
          ]
        },
        {
          "name": "Read it back",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/api/products/{{productId}}",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "api",
                "products",
                "{{productId}}"
              ]
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"status is 200\", function () { pm.response.to.have.status(200); });",
                  "pm.test(\"same product\", function () { const j = pm.response.json(); pm.expect(j.data.id == pm.collectionVariables.get(\"productId\"), \"same product\").to.be.true; });"
                ]
              }
            }
          ]
        },
        {
          "name": "Replace (PUT)",
          "request": {
            "method": "PUT",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/api/products/{{productId}}",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "api",
                "products",
                "{{productId}}"
              ]
            },
            "body": {
              "mode": "raw",
              "raw": "{\n  \"name\": \"Replaced\",\n  \"description\": \"created by api-tests\",\n  \"price\": 42.0,\n  \"category\": \"TOYS\",\n  \"sku\": \"{{sku}}\",\n  \"stock\": 5\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"status is 200\", function () { pm.response.to.have.status(200); });",
                  "pm.test(\"replaced\", function () { const j = pm.response.json(); pm.expect(j.data.name === \"Replaced\" && j.data.category === \"TOYS\", \"replaced\").to.be.true; });"
                ]
              }
            }
          ]
        },
        {
          "name": "Patch",
          "request": {
            "method": "PATCH",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/api/products/{{productId}}",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "api",
                "products",
                "{{productId}}"
              ]
            },
            "body": {
              "mode": "raw",
              "raw": "{\"price\": 1.5}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"status is 200\", function () { pm.response.to.have.status(200); });",
                  "pm.test(\"price patched\", function () { const j = pm.response.json(); pm.expect(j.data.price === 1.5 && j.data.name === \"Replaced\", \"price patched\").to.be.true; });"
                ]
              }
            }
          ]
        },
        {
          "name": "Delete as admin",
          "request": {
            "method": "DELETE",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/api/products/{{productId}}",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "api",
                "products",
                "{{productId}}"
              ]
            },
            "auth": {
              "type": "bearer",
              "bearer": [
                {
                  "key": "token",
                  "value": "{{adminToken}}",
                  "type": "string"
                }
              ]
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"status is 204\", function () { pm.response.to.have.status(204); });"
                ]
              }
            }
          ]
        },
        {
          "name": "Gone after delete",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/api/products/{{productId}}",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "api",
                "products",
                "{{productId}}"
              ]
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"status is 404\", function () { pm.response.to.have.status(404); });",
                  "pm.test(\"standard error envelope\", function () { const j = pm.response.json(); pm.expect(j.error && j.error.code === \"RESOURCE_NOT_FOUND\" && !!j.error.traceId && !!j.error.path, \"standard error envelope\").to.be.true; });"
                ]
              }
            }
          ]
        }
      ]
    },
    {
      "name": "Retry safety",
      "item": [
        {
          "name": "Create with Idempotency-Key",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Idempotency-Key",
                "value": "{{idemKey}}"
              },
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/api/products",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "api",
                "products"
              ]
            },
            "body": {
              "mode": "raw",
              "raw": "{\n  \"name\": \"API test product\",\n  \"description\": \"created by api-tests\",\n  \"price\": 19.99,\n  \"category\": \"BOOKS\",\n  \"sku\": \"{{idemSku}}\",\n  \"stock\": 5\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            }
          },
          "event": [
            {
              "listen": "prerequest",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.collectionVariables.set(\"idemKey\", pm.variables.replaceIn(\"{{$guid}}\")); pm.collectionVariables.set(\"idemSku\", \"IDEM-\" + Math.random().toString(36).substring(2, 10).toUpperCase());"
                ]
              }
            },
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"status is 201\", function () { pm.response.to.have.status(201); });",
                  "pm.test(\"header Idempotent-Replayed absent\", function () { pm.expect(pm.response.headers.has(\"Idempotent-Replayed\")).to.be.false; });",
                  "pm.collectionVariables.set(\"productId\", pm.response.json().data.id);"
                ]
              }
            }
          ]
        },
        {
          "name": "Retry with the same key",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Idempotency-Key",
                "value": "{{idemKey}}"
              },
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/api/products",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "api",
                "products"
              ]
            },
            "body": {
              "mode": "raw",
              "raw": "{\n  \"name\": \"API test product\",\n  \"description\": \"created by api-tests\",\n  \"price\": 19.99,\n  \"category\": \"BOOKS\",\n  \"sku\": \"{{idemSku}}\",\n  \"stock\": 5\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"status is 201\", function () { pm.response.to.have.status(201); });",
                  "pm.test(\"header Idempotent-Replayed = true\", function () { pm.expect(pm.response.headers.get(\"Idempotent-Replayed\")).to.eql(\"true\"); });",
                  "pm.test(\"same product returned\", function () { const j = pm.response.json(); pm.expect(j.data.id == pm.collectionVariables.get(\"productId\"), \"same product returned\").to.be.true; });"
                ]
              }
            }
          ]
        },
        {
          "name": "Clean up",
          "request": {
            "method": "DELETE",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/api/products/{{productId}}",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "api",
                "products",
                "{{productId}}"
              ]
            },
            "auth": {
              "type": "bearer",
              "bearer": [
                {
                  "key": "token",
                  "value": "{{adminToken}}",
                  "type": "string"
                }
              ]
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"status is 204\", function () { pm.response.to.have.status(204); });"
                ]
              }
            }
          ]
        }
      ]
    },
    {
      "name": "Roles and versions",
      "item": [
        {
          "name": "User cannot delete",
          "request": {
            "method": "DELETE",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/api/products/1",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "api",
                "products",
                "1"
              ]
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"status is 403\", function () { pm.response.to.have.status(403); });",
                  "pm.test(\"standard error envelope\", function () { const j = pm.response.json(); pm.expect(j.error && j.error.code === \"FORBIDDEN\" && !!j.error.traceId && !!j.error.path, \"standard error envelope\").to.be.true; });"
                ]
              }
            }
          ]
        },
        {
          "name": "Version 1 shape",
          "request": {
            "method": "GET",
            "header": [
              {
                "key": "X-API-Version",
                "value": "1"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/api/products/1",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "api",
                "products",
                "1"
              ]
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"status is 200\", function () { pm.response.to.have.status(200); });",
                  "pm.test(\"no sku\", function () { const j = pm.response.json(); pm.expect(j.data.sku === undefined, \"no sku\").to.be.true; });"
                ]
              }
            }
          ]
        },
        {
          "name": "Version 2 shape",
          "request": {
            "method": "GET",
            "header": [
              {
                "key": "X-API-Version",
                "value": "2"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/api/products/1",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "api",
                "products",
                "1"
              ]
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"status is 200\", function () { pm.response.to.have.status(200); });",
                  "pm.test(\"has sku and stock\", function () { const j = pm.response.json(); pm.expect(j.data.sku === \"SKU-001\" && typeof j.data.stock === \"number\", \"has sku and stock\").to.be.true; });"
                ]
              }
            }
          ]
        }
      ]
    }
  ]
}